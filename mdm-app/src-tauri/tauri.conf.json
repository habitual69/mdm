{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mDm Media Download Manager",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.mdm.app",
  "build": {
    "frontendDist": "../../crates/mdm-server/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    }
  }
}
